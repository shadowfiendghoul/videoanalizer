# =====================================================================
# VideoAnalyzer Configuration
# Get your free Google Gemini API key at: https://aistudio.google.com/app/apikey
# =====================================================================

# Gemini API Key (either GOOGLE_API_KEY or GEMINI_API_KEY is accepted)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# AI Models
GEMINI_MODEL=gemini-3.5-flash-lite
QUIZ_GEMINI_MODEL=gemini-3.5-flash-lite

# Generation Temperatures
QUIZ_CREATIVE_TEMPERATURE=0.95
QUIZ_VERIFIER_TEMPERATURE=0.1

# Directories
OUTPUT_DIR=./outputs
TEMP_DIR=./temp
