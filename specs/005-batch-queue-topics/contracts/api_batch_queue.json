{
  "openapi": "3.1.0",
  "info": {
    "title": "Batch Render Queue API",
    "version": "1.0.0",
    "description": "API endpoints for progressive generation, sequential rendering queue, and status monitoring."
  },
  "paths": {
    "/api/v1/quiz/batch/init": {
      "post": {
        "summary": "Initialize a batch session and start progressive paced script generation",
        "operationId": "initBatch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topics": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 2,
                    "maxItems": 20
                  },
                  "language": { "type": "string", "enum": ["ru", "en"], "default": "ru" },
                  "temperature": { "type": ["number", "null"], "minimum": 0.0, "maximum": 2.0 },
                  "fact_check": { "type": ["boolean", "null"] }
                },
                "required": ["topics"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch session initialized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchQueueState"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quiz/batch/queue/start": {
      "post": {
        "summary": "Enqueue approved batch items into sequential Remotion render queue",
        "operationId": "startBatchRenderQueue",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRenderStartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sequential queue started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchQueueState"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quiz/batch/queue/status": {
      "get": {
        "summary": "Get live status of active batch queue",
        "operationId": "getBatchQueueStatus",
        "responses": {
          "200": {
            "description": "Current status of all items in batch queue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchQueueState"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quiz/batch/queue/cancel/{item_id}": {
      "post": {
        "summary": "Cancel an item in queue",
        "operationId": "cancelQueueItem",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Item cancelled" }
        }
      }
    },
    "/api/v1/quiz/batch/queue/clear": {
      "post": {
        "summary": "Clear queue and cancel pending items",
        "operationId": "clearBatchQueue",
        "responses": {
          "200": { "description": "Queue cleared" }
        }
      }
    },
    "/api/v1/quiz/batch/queue/download-all": {
      "get": {
        "summary": "Download ZIP archive containing all completed videos",
        "operationId": "downloadAllCompletedBatchVideos",
        "responses": {
          "200": {
            "description": "ZIP file stream of completed MP4s",
            "content": {
              "application/zip": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchQueueItemStatus": {
        "type": "string",
        "enum": ["pending_generation", "pending_approval", "queued", "rendering", "completed", "failed", "cancelled"]
      },
      "BatchQueueItem": {
        "type": "object",
        "properties": {
          "item_id": { "type": "string" },
          "index": { "type": "integer" },
          "topic": { "type": "string" },
          "challenge": { "type": ["object", "null"] },
          "status": { "$ref": "#/components/schemas/BatchQueueItemStatus" },
          "progress_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "stage": { "type": "string" },
          "video_path": { "type": ["string", "null"] },
          "download_url": { "type": ["string", "null"] },
          "error_message": { "type": ["string", "null"] }
        },
        "required": ["item_id", "index", "topic", "status", "progress_percent", "stage"]
      },
      "BatchQueueState": {
        "type": "object",
        "properties": {
          "batch_id": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BatchQueueItem" }
          },
          "is_rendering": { "type": "boolean" },
          "active_item_id": { "type": ["string", "null"] },
          "completed_count": { "type": "integer" },
          "total_count": { "type": "integer" },
          "rate_limit_waiting": { "type": "boolean" },
          "rate_limit_delay_sec": { "type": "number" }
        },
        "required": ["batch_id", "items", "is_rendering", "completed_count", "total_count"]
      },
      "BatchRenderStartRequest": {
        "type": "object",
        "properties": {
          "batch_id": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BatchQueueItem" }
          },
          "voice": { "type": ["string", "null"] },
          "background_video": { "type": ["string", "null"], "default": "random" },
          "banner_video": { "type": ["string", "null"] },
          "background_music": { "type": ["string", "null"] },
          "background_music_volume": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.18 },
          "retention_enabled": { "type": "boolean", "default": true },
          "rank_bar_enabled": { "type": "boolean", "default": true },
          "stress_timer_enabled": { "type": "boolean", "default": true },
          "streak_fire_enabled": { "type": "boolean", "default": true },
          "comment_trap_enabled": { "type": "boolean", "default": true },
          "render_profile": { "type": "string", "default": "balanced" }
        },
        "required": ["batch_id", "items"]
      }
    }
  }
}
