{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisualImageQuizRemotionProps",
  "type": "object",
  "required": [
    "dataset",
    "fps",
    "width",
    "height",
    "total_duration_frames",
    "hook_end_frame",
    "timing_slots",
    "audio_mix_path"
  ],
  "properties": {
    "fps": { "type": "integer", "enum": [30, 60] },
    "width": { "type": "integer", "const": 1080 },
    "height": { "type": "integer", "const": 1920 },
    "total_duration_frames": { "type": "integer", "minimum": 600 },
    "hook_end_frame": { "type": "integer", "minimum": 120 },
    "audio_mix_path": { "type": "string" },
    "background_video_path": { "type": ["string", "null"] },
    "timing_slots": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "start_frame",
          "timer_start_frame",
          "timer_duration_frames",
          "answer_audio_start_frame",
          "reveal_frame",
          "end_frame"
        ],
        "properties": {
          "question_id": { "type": "integer" },
          "start_frame": { "type": "integer" },
          "timer_start_frame": { "type": "integer" },
          "timer_duration_frames": { "type": "integer" },
          "answer_audio_start_frame": { "type": "integer" },
          "reveal_frame": { "type": "integer" },
          "end_frame": { "type": "integer" }
        }
      }
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "start_frame", "end_frame"],
        "properties": {
          "word": { "type": "string" },
          "start_frame": { "type": "integer" },
          "end_frame": { "type": "integer" }
        }
      }
    }
  }
}
