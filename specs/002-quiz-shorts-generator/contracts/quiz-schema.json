{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuizChallengeSchema",
  "description": "Pydantic v2 contract for the 9-question 3-tier trivia challenge generated by @script-service",
  "type": "object",
  "required": ["topic", "language", "total_questions", "tiers"],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "language": {
      "type": "string",
      "enum": ["ru", "en"],
      "default": "ru"
    },
    "total_questions": {
      "type": "integer",
      "const": 9
    },
    "tiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["tier_level", "tier_index", "theme_color", "questions"],
        "properties": {
          "tier_level": {
            "type": "string",
            "enum": ["easy", "medium", "hard"]
          },
          "tier_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "theme_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "questions": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "question_number",
                "difficulty",
                "tier_index",
                "question_text",
                "correct_answer",
                "fun_fact"
              ],
              "properties": {
                "question_number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9
                },
                "difficulty": {
                  "type": "string",
                  "enum": ["easy", "medium", "hard"]
                },
                "tier_index": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "question_text": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 150
                },
                "correct_answer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "fun_fact": {
                  "type": "string",
                  "maxLength": 200
                },
                "image_query": {
                  "type": ["string", "null"]
                },
                "local_image_path": {
                  "type": ["string", "null"]
                }
              }
            }
          }
        }
      }
    }
  }
}
