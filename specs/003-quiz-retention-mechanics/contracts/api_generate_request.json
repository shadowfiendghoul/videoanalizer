{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuizGenerateRequestWithRetention",
  "type": "object",
  "required": ["topic"],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Topic or trivia theme"
    },
    "language": {
      "type": "string",
      "enum": ["ru", "en"],
      "default": "ru"
    },
    "voice": {
      "type": ["string", "null"],
      "description": "Optional Edge-TTS neural voice"
    },
    "background_path": {
      "type": ["string", "null"],
      "description": "Optional specific background video path or filename"
    },
    "banner_path": {
      "type": ["string", "null"],
      "description": "Optional uploaded center promo banner video"
    },
    "retention_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master switch to enable all viral retention mechanics"
    },
    "rank_bar_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable top IQ/Rank bar (NPC -> 1% Geniuses)"
    },
    "stress_timer_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable blitz accelerating stress timer (3.0s -> 2.5s -> 1.8s)"
    },
    "streak_fire_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable combo streak flame counter with ultra mode"
    },
    "comment_trap_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable controversy bait and outro comment callout"
    },
    "approved_challenge": {
      "type": ["object", "null"],
      "description": "Optional pre-approved QuizChallenge object from preview endpoint"
    }
  }
}
